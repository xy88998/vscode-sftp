{
  "name": "vscode-nvm",
  "displayName": "VS Code NVM",
  "description": "Switch Node.js versions using NVM in VS Code",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/username/vscode-nvm.git"
  },
  "publisher": "vscode-nvm",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nvm.switchVersion",
        "title": "NVM: Switch Node.js Version"
      }
    ],
    "configuration": {
      "title": "VS Code NVM",
      "properties": {
        "vscode-nvm.autoSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable automatic Node.js version switching when a new terminal is opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}